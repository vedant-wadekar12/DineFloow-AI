# DineFlow AI Nginx Load Balancer Configuration Example
# Place this in your Nginx conf.d/ directory or nginx.conf

# Architecture Option A: Single PM2 Cluster Pool (Shared Port 5000)
# Use this when PM2 runs in cluster mode ('exec_mode: "cluster"', 'instances: 4') on port 5000.
upstream dineflow_cluster_backend {
    server 127.0.0.1:5000 max_fails=3 fail_timeout=10s;
}

# Architecture Option B: Multi-Port Pool (Ports 5000, 5001, 5002, 5003)
# Use this if running 4 separate process instances listening on explicit distinct ports.
# upstream dineflow_multiport_backend {
#     ip_hash; # Sticky sessions recommended if Socket.IO without Redis adapter
#     server 127.0.0.1:5000 max_fails=3 fail_timeout=10s;
#     server 127.0.0.1:5001 max_fails=3 fail_timeout=10s;
#     server 127.0.0.1:5002 max_fails=3 fail_timeout=10s;
#     server 127.0.0.1:5003 max_fails=3 fail_timeout=10s;
# }

server {
    listen 80;
    server_name api.dineflow.example.com;

    # Client payload limit
    client_max_body_size 10M;

    # Gzip Compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Health & Readiness probe endpoints
    location /api/v1/health {
        proxy_pass http://dineflow_cluster_backend/api/v1/health;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /api/v1/ready {
        proxy_pass http://dineflow_cluster_backend/api/v1/ready;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Main API Routing & WebSocket Proxying
    location / {
        proxy_pass http://dineflow_cluster_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_cache_bypass $http_upgrade;

        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
